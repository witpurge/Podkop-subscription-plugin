#!/bin/sh
# shellcheck shell=dash
# shellcheck disable=SC3043 # busybox ash has `local`; podkop's own script relies on it
# shellcheck disable=SC2016 # single-quoted jq filters use jq's own $vars, not the shell's
# podkop-sub: keeps podkop's section configs in sync with VPN subscriptions.
# No `set -u`/`set -e`: /lib/functions.sh reads unset vars and config_foreach fails under `set -e`.

CACHE_DIR=/etc/podkop-sub/cache
BACKUP_DIR=/etc/podkop-sub/backup
STATE=/etc/podkop-sub/state.json
LOCK=/var/lock/podkop-sub.lock
PODKOP=/usr/bin/podkop
INIT=/etc/init.d/podkop-sub
# ~3 minutes for the proxy groups to come back; the env hook exists only for the tests
# shellcheck disable=SC2034 # read by podkop.sh and health.sh
RESTORE_WAIT=${PODKOP_SUB_WAIT:-90}

# shellcheck source=/dev/null
[ -r /usr/share/podkop-sub/version ] && . /usr/share/podkop-sub/version
PLUGIN_VERSION=${PLUGIN_VERSION:-0.0.0}
TARGET_PODKOP=${TARGET_PODKOP:-}

if [ -z "$PODKOP_SUB_TEST" ]; then
    # shellcheck source=/dev/null
    . /lib/functions.sh
    config_load podkop-sub
fi

# one file per layer, sourced in dependency order; see each for what it owns
for _m in state link podkop subs health; do
    _f="/usr/share/podkop-sub/lib/$_m.sh"
    # a hand copy of the entry point alone is the likely cause, and busybox would only say "can't open"
    [ -r "$_f" ] || {
        echo "podkop-sub: $_f is missing or not readable, the install is incomplete" >&2
        exit 1
    }
    # shellcheck source=/dev/null
    . "$_f"
done
unset _m _f

podkop_version() {
    local v
    v=$("$PODKOP" show_version 2> /dev/null | head -n 1 | tr -d '\r')
    printf '%s' "${v#v}"
}

# there is no `enabled` option in the config on purpose: the service state is the switch
svc_state() {
    if [ -x "$INIT" ] && "$INIT" "$1" > /dev/null 2>&1; then echo true; else echo false; fi
}

status_sub() {
    local sec="$1" dir="$2" url name id en secs s names
    config_get url "$sec" url
    [ -n "$url" ] || return 0
    config_get name "$sec" name
    id=$(sub_id "$url")
    names="$dir/nodes.$id"
    sub_names "$id" > "$names"
    state_json | jq -c --arg id "$id" --arg url "$url" --arg name "$name" \
        --rawfile nodes "$names" '
        (.subs[$id] // {}) as $s |
        {id: $id, url: $url, name: $name,
         count: ($s.count // 0), skipped: ($s.skipped // 0), updated: ($s.updated // 0),
         status: ($s.status // "never"), error: ($s.error // ""),
         expire: ($s.expire // 0), traffic_left: ($s.traffic_left // 0),
         nodes: ($nodes | split("\n") | map(select(length > 0))),
         missing: (if ($s.missing_ack // false) then [] else ($s.missing // []) end)}' >> "$dir/subs"
    config_get_bool en "$sec" enabled 1
    [ "$en" = 1 ] || return 0
    config_get secs "$sec" sections
    for s in $secs; do printf '%s\n' "$s" >> "$dir/names"; done
}

cmd_status() {
    local dir s st
    dir=$(mktemp -d) || return 1
    : > "$dir/subs"
    : > "$dir/secs"
    : > "$dir/names"
    config_foreach status_sub subscription "$dir"
    st=$(state_json)
    awk '!seen[$0]++' "$dir/names" | while IFS= read -r s; do
        [ -n "$s" ] || continue
        uci -q get "podkop.$s" > /dev/null 2>&1 || continue
        printf '%s' "$st" | jq -c --arg s "$s" --arg m "$(section_mode "$s")" '
            (.sections[$s] // {}) as $x |
            ($x | '"$HEALTH"') as $h |
            {name: $s, mode: $m, links: ($x.links // 0),
             checked: ($x.checked // 0),
             status: (if $m == "" then "no-mode" else ($x.status // "stale") end),
             selected: ($x.selected // ""), fails: ($x.fails // 0),
             failover: ($x.failover // ""), added: ($x.added // ""),
             health: (if $h == ($x.health_ack // "") then "ok" else $h end)}' >> "$dir/secs"
    done
    jq -n --slurpfile subs "$dir/subs" --slurpfile sections "$dir/secs" \
        --arg version "$PLUGIN_VERSION" --arg pv "$(podkop_version)" \
        --arg tp "$TARGET_PODKOP" \
        --argjson running "$(svc_state running)" --argjson enabled "$(svc_state enabled)" \
        '{version: $version, podkop_version: $pv, target_podkop: $tp,
          subs: $subs, sections: $sections,
          service: {running: $running, enabled: $enabled}}'
    rm -rf "$dir"
}

usage() {
    cat << EOF
usage: podkop-sub <command>
  update [--all|<sub_id>] [--force]   download subscriptions into the cache
  apply [--force]                     write the cached links into podkop's sections
  check                               ping the managed sections, refresh the dead ones
  daemon                              check loop for /etc/init.d/podkop-sub, not for hand use
  restore [<section>]                 put podkop's sections back as they were
  ack <sub_id>                        stop warning about the nodes that vanished
  ack-section <section>               stop warning about that section's current state
  status                              current state as JSON
  logs [--clear]                      print the debug log, or empty it
  version                             plugin version
EOF
}

main() {
    mkdir -p "$CACHE_DIR" "$BACKUP_DIR" "$(dirname "$LOCK")"
    # the cache and the state hold subscription URLs and proxy links: root only
    chmod 0700 "$(dirname "$STATE")" "$CACHE_DIR" "$BACKUP_DIR" 2> /dev/null
    chmod 0600 /etc/config/podkop-sub 2> /dev/null
    case "${1:-}" in
        update)
            shift
            cmd_update "$@"
            ;;
        apply)
            shift
            # what he saved is the truth now: his old pick and our failover both go
            # shellcheck disable=SC2034 # read by write_section in podkop.sh
            APPLY_KEEP=''
            cmd_apply "$@"
            ;;
        check) cmd_check ;;
        daemon) cmd_daemon ;;
        restore)
            shift
            cmd_restore "$@"
            ;;
        ack)
            shift
            cmd_ack "$@"
            ;;
        ack-section)
            shift
            cmd_ack_section "$@"
            ;;
        status) cmd_status ;;
        logs)
            shift
            cmd_logs "$@"
            ;;
        version) echo "$PLUGIN_VERSION" ;;
        *)
            usage
            exit 1
            ;;
    esac
}

[ -n "$PODKOP_SUB_TEST" ] || main "$@"
